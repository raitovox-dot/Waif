# ═══════════════════════════════════════
#  WAIFU BOT — .env.example
# ═══════════════════════════════════════

# Telegram bot tokeni (BotFather dan oling)
BOT_TOKEN=1234567890:ABC-your-token-here

# PostgreSQL ma'lumotlar bazasi URL
DATABASE_URL=postgresql://user:password@host:5432/dbname

# God Admin user ID (siz)
GOD_ADMIN_ID=123456789

# Botning asosiy guruhi ID (event spam uchun)
# Bu guruhda eventlar ishlaydi
BOT_GROUP_ID=-1001234567890

# Botning kanali ID (xabarlar uchun)
BOT_CHANNEL_ID=-1001234567891

# Botning usernamei (@ siz)
BOT_USERNAME=your_bot_username

# Webhook sozlamalari (ixtiyoriy — Railway/Render uchun)
# WEBHOOK_URL=https://your-app.up.railway.app
# PORT=8443
